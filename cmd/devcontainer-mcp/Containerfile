FROM docker.io/library/debian:bookworm-slim

ARG BUN_VERSION=bun-v1.4.5
ARG TARGETARCH

RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates curl unzip \
 && rm -rf /var/lib/apt/lists/*

RUN set -eux; \
    case "${TARGETARCH:-amd64}" in \
      amd64) asset=bun-linux-x64 ;; \
      arm64) asset=bun-linux-aarch64 ;; \
      *) echo "unsupported architecture: ${TARGETARCH}" >&2; exit 1 ;; \
    esac; \
    cd /tmp; \
    curl -fsSLO "https://github.com/oven-sh/bun/releases/download/${BUN_VERSION}/${asset}.zip"; \
    curl -fsSLO "https://github.com/oven-sh/bun/releases/download/${BUN_VERSION}/SHASUMS256.txt"; \
    grep " ${asset}.zip\$" SHASUMS256.txt | sha256sum -c -; \
    unzip -q "${asset}.zip"; \
    install -m 0755 "${asset}/bun" /usr/local/bin/bun; \
    rm -rf /tmp/*; \
    bun --version

RUN useradd --create-home --uid 1000 --shell /bin/bash dev
USER dev
WORKDIR /home/dev
CMD ["sleep", "infinity"]
